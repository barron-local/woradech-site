# ==========================================
# Supabase Configuration
# ==========================================
# URL ของโปรเจกต์ Supabase (ตัวอย่าง: https://xxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url

# Public Anon Key ของ Supabase (anon / public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==========================================
# Admin Access Configuration
# ==========================================
# รหัส PIN สำหรับเข้าสู่โหมด Admin (ค่าเริ่มต้น: 1234)
VITE_ADMIN_PIN=1234
